# Stripe API Configuration
# Get your Stripe API keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=your_stripe_test_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace 'your_stripe_test_key_here' with your actual Stripe test API key
# 3. For production, use your live API key (sk_live_...)
# 4. Never commit .env file to git

# OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/oauth-success

# Optional: public base URL used for QR codes (mobile scanners)
# Example: http://192.168.1.50:3000
NEXT_PUBLIC_QR_BASE_URL=
